{
  "name": "dsh-tinymce-html-editor",
  "version": "1.0.0",
  "description": "TinyMCE WYSIWYG editor for HTML files in the DeepSeek Harness Better Sidebar.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "vendor/**",
    "LICENSE",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tinymce",
    "html",
    "editor"
  ],
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.28.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustock/TinyMCE-for-Deepseek-Harness.git"
  },
  "homepage": "https://github.com/gustock/TinyMCE-for-Deepseek-Harness#readme",
  "bugs": {
    "url": "https://github.com/gustock/TinyMCE-for-Deepseek-Harness/issues"
  }
}
